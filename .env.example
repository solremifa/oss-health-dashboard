# 이 파일을 .env로 복사한 뒤 실제 값을 채운다.
#   cp .env.example .env
# .env는 .gitignore에 등록되어 있으며 절대 커밋하지 않는다.

# ---------------------------------------------------------------------------
# GitHub API
# ---------------------------------------------------------------------------
# 필수. 미인증 상태의 레이트리밋은 60 req/시간이라 수집이 불가능하다.
# (실측 근거: docs/findings.md 1절)
#
# public 저장소만 읽으므로 Fine-grained token에 아래 권한만 있으면 충분하다.
#   Repository access : Public repositories (read-only)
# 추가 스코프는 필요 없다. classic token이라면 스코프를 전부 해제해도 된다.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Anthropic API
# ---------------------------------------------------------------------------
# 이슈 본문을 구조화된 JSON으로 분류할 때 사용한다.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# 애플리케이션 설정 (기본값이 있으므로 생략 가능)
# ---------------------------------------------------------------------------
# 접속 문자열은 이 환경변수 하나로만 결정한다. 코드에 경로를 하드코딩하지 않는다.
DATABASE_URL=sqlite:///./oss_health.db

# 분석 대상 저장소. "owner/name" 형식만 허용한다.
TARGET_REPO=PrefectHQ/fastmcp

# 지표 집계 기간(일). created_at 기준으로 자른다.
# 주의: GitHub API의 since 파라미터는 updated_at 기준이라 수집 축과 집계 축이
#       다르다. 자세한 내용은 docs/findings.md 함정 2 참고.
WINDOW_DAYS=180

# "방치된 이슈" 판정 기준(일). 이 기간 넘게 메인테이너 응답이 없는 open 이슈.
STALE_DAYS=90

# 로그 레벨: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
